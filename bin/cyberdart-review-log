#!/usr/bin/env bash
# cyberdart-review-log — atomically log a review result
# Usage: cyberdart-review-log '{"skill":"...","timestamp":"...","status":"..."}'
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
eval "$("$SCRIPT_DIR/cyberdart-slug" 2>/dev/null)"
CYBERDART_HOME="${CYBERDART_HOME:-$HOME/.cyberdart}"
mkdir -p "$CYBERDART_HOME/projects/$SLUG"

# Validate: input must be parseable JSON (reject malformed or injection attempts)
INPUT="$1"
if ! printf '%s' "$INPUT" | bun -e "JSON.parse(await Bun.stdin.text())" 2>/dev/null; then
  # Not valid JSON — refuse to append
  echo "cyberdart-review-log: invalid JSON, skipping" >&2
  exit 1
fi

echo "$INPUT" >> "$CYBERDART_HOME/projects/$SLUG/$BRANCH-reviews.jsonl"

# gbrain-sync: enqueue for cross-machine sync (no-op if sync is off).
"$SCRIPT_DIR/cyberdart-brain-enqueue" "projects/$SLUG/$BRANCH-reviews.jsonl" 2>/dev/null &
